# ─── User-generated runtime data (kept out of the repo) ───────────────────────
# Per-user uploaded media (videos, audio, slides). Keep the dir, drop contents.
backend/uploads/*
!backend/uploads/.gitkeep

# Per-user generated PDFs / PPTX exports.
backend/generated/*
!backend/generated/.gitkeep

# Static-served runtime files.
backend/static/*
!backend/static/.gitkeep

# Pipeline session snapshots written at end-of-run.
backend/data/session.json
backend/data/sessions/*
!backend/data/sessions/.gitkeep

